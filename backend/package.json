{
  "name": "@cleancare/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "dev:watch": "nest start --watch",
    "build": "prisma generate --schema=../database/prisma/schema.prisma && nest build",
    "buildyarn": "prisma generate --schema=../database/prisma/schema.prisma && nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\"",
    "prisma:generate": "prisma generate --schema=../database/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema=../database/prisma/schema.prisma",
    "prisma:migrate:simple": "DATABASE_URL=\"postgresql://localhost:5432/cleancare_db?schema=public\" prisma migrate dev --schema=../database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../database/prisma/schema.prisma",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.3.9",
    "@nestjs/core": "10.3.9",
    "@nestjs/platform-express": "10.3.9",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/config": "3.2.2",
    "@nestjs/throttler": "5.1.2",
    "@nestjs/swagger": "7.3.1",
    "@nestjs/schedule": "4.0.2",
    "@nestjs/event-emitter": "2.0.4",
    "@nestjs/websockets": "10.3.9",
    "@nestjs/platform-socket.io": "10.3.9",
    "@prisma/client": "5.14.0",
    "prisma": "5.14.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "bcryptjs": "2.4.3",
    "class-validator": "0.14.1",
    "class-transformer": "0.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "helmet": "7.1.0",
    "compression": "1.7.4",
    "multer": "1.4.5-lts.1",
    "sharp": "0.33.4",
    "nanoid": "3.3.7",
    "dayjs": "1.11.11",
    "axios": "1.6.8",
    "ioredis": "5.3.2",
    "socket.io": "4.7.5",
    "pdf-lib": "1.17.1",
    "@aws-sdk/client-s3": "3.582.0",
    "@aws-sdk/s3-request-presigner": "3.582.0",
    "razorpay": "2.9.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.3.2",
    "@nestjs/testing": "10.3.9",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/multer": "1.4.11",
    "@types/node": "20.12.7",
    "@types/passport-jwt": "4.0.1",
    "typescript": "5.3.3",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0"
  }
}
