NODE_ENV=production
PORT=4000

DATABASE_URL="postgresql://user:password@host:5432/cleancare_db?sslmode=require"
REDIS_URL="redis://default:password@host:6379"

JWT_SECRET=cleancare_production_jwt_secret_key_minimum_64_chars_long_abcdefghijklmnopqrstuvwxyz
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=cleancare_production_refresh_secret_key_minimum_64_chars_long_abcdefghijklmnop
REFRESH_TOKEN_EXPIRES_IN=30d

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DEV_MODE=true
OTP_TEST_CODE=123456

CUSTOMER_APP_URL=https://your-customer-app.vercel.app
DRIVER_APP_URL=https://your-driver-app.vercel.app
ADMIN_APP_URL=https://your-admin-app.vercel.app
CORS_ORIGINS=https://your-customer-app.vercel.app,https://your-driver-app.vercel.app,https://your-admin-app.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:3002

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
