{
  "name": "cleancare",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/customer",
    "apps/driver",
    "apps/admin",
    "packages/types",
    "packages/ui",
    "backend"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=apps/customer",
    "dev:driver":   "npm run dev --workspace=apps/driver",
    "dev:admin":    "npm run dev --workspace=apps/admin",
    "dev:backend":  "npm run dev --workspace=backend",
    "build:all":    "npm run build --workspaces",
    "build:backend": "npm run prisma:generate --workspace=backend && npm run build --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "db:generate":  "npm run prisma:generate --workspace=backend",
    "db:migrate":   "npm run prisma:migrate --workspace=backend",
    "db:seed":      "npm run db:seed --workspace=backend"
  },
  "devDependencies": {
    "typescript": "5.3.3"
  }
}
