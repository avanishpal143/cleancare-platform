# ============================================================
# CleanCare — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=4000

# ---- Database ----
DATABASE_URL="postgresql://cleancare:password@localhost:5432/cleancare_db?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Authentication ----
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# ---- OTP ----
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Set to "true" in development to use test OTP (see OTP_TEST_CODE)
OTP_DEV_MODE=true
OTP_TEST_CODE=123456

# ---- SMS / OTP Provider (Twilio / MSG91 / Fast2SMS) ----
SMS_PROVIDER=msg91
SMS_PROVIDER_KEY=replace_with_sms_provider_key
SMS_SENDER_ID=CLNCAR

# ---- WhatsApp Provider ----
WHATSAPP_PROVIDER=twilio
WHATSAPP_PROVIDER_KEY=replace_with_whatsapp_key
WHATSAPP_FROM_NUMBER=+1234567890

# ---- Email Provider (SendGrid / SMTP) ----
EMAIL_PROVIDER=sendgrid
EMAIL_PROVIDER_KEY=replace_with_email_api_key
EMAIL_FROM_ADDRESS=noreply@cleancare.app
EMAIL_FROM_NAME=CleanCare

# ---- Payment Gateway (Razorpay) ----
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=replace_with_razorpay_key_id
PAYMENT_KEY_SECRET=replace_with_razorpay_key_secret
PAYMENT_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# ---- Object Storage (S3-compatible) ----
STORAGE_PROVIDER=s3
STORAGE_BUCKET=cleancare-uploads
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=replace_with_access_key
STORAGE_SECRET_KEY=replace_with_secret_key
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_CDN_URL=https://cdn.cleancare.app

# ---- Maps ----
MAPS_PROVIDER=google
MAPS_API_KEY=replace_with_google_maps_api_key

# ---- Push Notifications (Firebase) ----
FIREBASE_PROJECT_ID=replace_with_project_id
FIREBASE_PRIVATE_KEY=replace_with_private_key
FIREBASE_CLIENT_EMAIL=replace_with_client_email

# ---- Frontend URLs ----
CUSTOMER_APP_URL=http://localhost:3000
DRIVER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
